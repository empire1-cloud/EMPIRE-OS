from fastapi import APIRouter
from app.services.repo_parser import ingest_repo

router = APIRouter()

@router.post("/repo")
def ingest(payload: dict):
    repo_url = payload["repo_url"]
    result = ingest_repo(repo_url)

    return {
        "status": "ingested",
        "repo": result["repo"],
        "modules": len(result["modules"])
    }
